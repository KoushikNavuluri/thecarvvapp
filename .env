# ---------------------------------------------------------------
# Carvv environment configuration
# Copy to .env and fill in. NEVER commit a real .env to git.
# ---------------------------------------------------------------

# --- Client (exposed to the browser, safe: project IDs are public) ---
# The endpoint MUST match the project's region. Project "carvv"
# (6ab22ff00001b59e3839) lives in NYC, so this is the NYC host.
# Using another region's host makes every auth/DB call 404.
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6ab22ff00001b59e3839
VITE_APPWRITE_DATABASE_ID=carvv-db

# Optional: where the Carvv API server lives.
# Leave blank in dev (the Vite proxy forwards /api to localhost:8787)
# or when the server serves the built client on the same origin.
VITE_API_BASE=

# --- Server only (never prefixed with VITE_, never shipped to browsers) ---
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
PORT=8787
