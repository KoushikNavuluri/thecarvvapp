{
  "name": "the-carvv-app",
  "version": "1.0.0",
  "private": true,
  "description": "Carvv: an AI research-to-carousel studio. Idea in, publish-ready visual story out.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,magenta \"vite\" \"node --watch server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node -e \"process.env.NODE_ENV='production'; import('./server/index.js').catch(err => { console.error(err); process.exitCode = 1; })\""
  },
  "dependencies": {
    "appwrite": "^16.0.2",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "html-to-image": "^1.11.11",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18.17"
  }
}
