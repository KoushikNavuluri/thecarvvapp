{
  "name": "the-carvv-app",
  "version": "1.0.0",
  "private": true,
  "description": "Carvv: an AI research-to-carousel studio. Idea in, publish-ready visual story out.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,magenta \"vite\" \"node --watch server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "appwrite": "^16.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "cheerio": "^1.0.0",
    "concurrently": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18.17"
  }
}
